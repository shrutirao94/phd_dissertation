@inproceedings{economidou2023engaging,
  author = {Economidou, Eleni},
title = {Engaging the General Public in Speculation on Human-Building Interaction Futures at a Pop-up Event: A Design Fiction Approach},
year = {2023},
isbn = {9798400708749},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3616961.3616966},
doi = {10.1145/3616961.3616966},
abstract = {The blend of novel technologies and built environments gave rise to the emerging field of human-building interaction (HBI) and introduced fresh forms of spatial experience. Civic involvement and engagement are paramount to HBI research and outreach, yet remain under-explored when speculating its future. Additionally, the various forms and functioning of such interfaces remain enigmatic for the general public. To address this disparity, we present our design fiction approach aimed at engaging citizens in speculating on HBI futures at a pop-up event. Through the pop-up format, visitors are initiated to the event’s subject matter through an exhibition and then invited to participate in a design fiction activity. We report on our approach through an implemented use case with 26 participants. Based on our learnings from organising, designing, and implementing this approach, we discuss the strengths, opportunities, and limitations of our work for other researchers interested in involving the general public in speculation.},
booktitle = {Proceedings of the 26th International Academic Mindtrek Conference},
pages = {154–168},
numpages = {15},
keywords = {design fiction, exhibition, human-building interaction, pop-up event, pop-up science, public engagement, speculative design},
location = {Tampere, Finland},
series = {Mindtrek '23}
}


@inproceedings{pschetz2019autonomous,
  author = {Pschetz, Larissa and Pothong, Kruakae and Speed, Chris},
title = {Autonomous Distributed Energy Systems: Problematising the Invisible through Design, Drama and Deliberation},
year = {2019},
isbn = {9781450359702},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3290605.3300617},
doi = {10.1145/3290605.3300617},
abstract = {Technologies such as blockchains, smart contracts and programmable batteries facilitate emerging models of energy distribution, trade and consumption, and generate a considerable number of opportunities for energy markets. However, these developments complicate relationships between stakeholders, disrupting traditional notions of value, control and ownership. Discussing these issues with the public is particularly challenging as energy consumption habits often obscure the competing values and interests that shape stakeholders' relationships. To make such difficult discussions more approachable and examine the missing relational aspect of autonomous energy systems, we combined the design of speculative hairdryers with performance and deliberation. This integrated method of inquiry makes visible the competing values and interests, eliciting people's wishes to negotiate these terms. We argue that the complexity of mediated energy distribution and its convoluted stakeholder relationships requires more sophisticated methods of inquiry to engage people in debates concerning distributed energy systems.},
booktitle = {Proceedings of the 2019 CHI Conference on Human Factors in Computing Systems},
pages = {1–14},
numpages = {14},
keywords = {blockchain, critical design, deliberation, distributed energy, improvisation, performance, speculative design, theatre},
location = {Glasgow, Scotland Uk},
series = {CHI '19}
}

